! ============================================================
! HPL (Hewlett-Packard Language) サンプルコード集
! HP 9825A デスクトップ計算機用
! ============================================================


! ------------------------------------------------------------
! 【1】Hello World — 画面への文字出力
! ------------------------------------------------------------
!
! prt : print（出力）命令
! end : プログラム終了

  prt "Hello, World!"
  end


! ------------------------------------------------------------
! 【2】変数と四則演算
! ------------------------------------------------------------
!
! HPL では変数名に英字を使用（主に A〜Z の1〜2文字）
! = は代入、prt で結果を表示

  A = 10
  B = 3

  prt "A + B = "; A + B
  prt "A - B = "; A - B
  prt "A * B = "; A * B
  prt "A / B = "; A / B
  end


! ------------------------------------------------------------
! 【3】条件分岐 (if / gto)
! ------------------------------------------------------------
!
! if  : 条件が真なら次の文を実行
! gto : go to（指定ラベルへジャンプ）
! lbl : ラベル定義

  X = 42

  if X > 0; gto POS
  if X < 0; gto NEG
  prt "X = 0"
  gto END

POS:
  prt "X is positive: "; X
  gto END

NEG:
  prt "X is negative: "; X

END:
  end


! ------------------------------------------------------------
! 【4】ループ処理 (for / nxt)
! ------------------------------------------------------------
!
! for : カウンタ変数に範囲を設定してループ開始
! nxt : next（ループの次の繰り返しへ）
! ステップ値の省略時は 1 が使われる

  S = 0
  for I = 1 to 10
    S = S + I
  nxt I

  prt "1 から 10 の合計 = "; S
  end


! ------------------------------------------------------------
! 【5】サブルーチン (gsb / ret)
! ------------------------------------------------------------
!
! gsb : go to subroutine（サブルーチン呼び出し）
! ret : return（サブルーチンから戻る）

  A = 5
  B = 8
  gsb MAX           ! サブルーチン MAX を呼び出す
  prt "最大値 = "; R
  end

MAX:
  if A >= B; R = A
  if A < B;  R = B
  ret


! ------------------------------------------------------------
! 【6】配列と平均値の計算
! ------------------------------------------------------------
!
! dim : 配列の宣言（次元確保）
! HPL の配列はインデックス 1 始まり

  dim D(5)
  D(1) = 10
  D(2) = 20
  D(3) = 30
  D(4) = 40
  D(5) = 50

  T = 0
  for I = 1 to 5
    T = T + D(I)
  nxt I

  AVG = T / 5
  prt "合計    = "; T
  prt "平均値  = "; AVG
  end


! ------------------------------------------------------------
! 【7】ユーザー入力と BMI 計算
! ------------------------------------------------------------
!
! ipt : input（キーボードからの入力受け付け）

  prt "体重 (kg) を入力してください:"
  ipt W
  prt "身長 (m) を入力してください:"
  ipt H

  BMI = W / (H * H)
  prt "BMI = "; BMI

  if BMI < 18.5; prt "判定: 低体重"
  if BMI >= 18.5 and BMI < 25; prt "判定: 普通体重"
  if BMI >= 25;  prt "判定: 過体重"
  end


! ------------------------------------------------------------
! 【8】フィボナッチ数列（最初の 10 項）
! ------------------------------------------------------------

  A = 0
  B = 1
  prt "フィボナッチ数列:"
  prt A
  prt B

  for I = 3 to 10
    C = A + B
    prt C
    A = B
    B = C
  nxt I

  end


! ------------------------------------------------------------
! 【9】素数判定
! ------------------------------------------------------------
!
! N が素数かどうかを判定するサブルーチン PRIME を呼び出す
! 結果は変数 F に格納（1=素数, 0=素数でない）

  prt "2 から 20 の素数:"
  for N = 2 to 20
    gsb PRIME
    if F = 1; prt N
  nxt N
  end

PRIME:
  F = 1
  if N < 2; F = 0
  if N < 2; ret
  for K = 2 to int(sqr(N))
    if N - int(N/K)*K = 0; F = 0
    if F = 0; gto PDONE
  nxt K
PDONE:
  ret


! ------------------------------------------------------------
! 【10】テープ（ストレージ）への書き込みと読み込み
! ------------------------------------------------------------
!
! HPL の特徴的な命令：カセットテープへのデータ保存
! store : テープにデータを書き込む
! load  : テープからデータを読み込む
! (HP 9825A はカセットテープをストレージとして使用)

  A = 3.14159
  B = 2.71828

  prt "テープにデータを書き込み中..."
  store 1; A, B          ! テープ番号1 に A, B を保存

  A = 0
  B = 0

  prt "テープからデータを読み込み中..."
  load 1; A, B           ! テープ番号1 から A, B を復元

  prt "読み込んだ A = "; A
  prt "読み込んだ B = "; B
  end

! ============================================================
! 主な HPL 命令一覧
! ============================================================
!
!  prt  (print)           : 画面/プリンターへ出力
!  ipt  (input)           : キーボードから入力
!  gto  (go to)           : 無条件ジャンプ
!  gsb  (go to sub)       : サブルーチン呼び出し
!  ret  (return)          : サブルーチンからリターン
!  if                     : 条件分岐
!  for  〜 to  〜 step    : カウントループ開始
!  nxt  (next)            : ループの次の繰り返し
!  dim  (dimension)       : 配列宣言
!  lbl  (label)           : ラベル定義
!  end                    : プログラム終了
!  store                  : テープへ書き込み
!  load                   : テープから読み込み
!  int  (integer part)    : 整数部を返す関数
!  sqr  (square root)     : 平方根を返す関数
!  abs  (absolute value)  : 絶対値を返す関数
!  sin / cos / tan        : 三角関数
!  log / exp              : 常用対数 / 指数関数
! ============================================================
